atr_expansion = { base_score = 0.60, atr_mean_window = 20, min_atr_expansion_ratio = 2.5, min_body_atr = 0.25, signal_lookback_bars = 8, sl_buffer_atr = 0.85, min_rr = 1.9 }
ls_ratio_extreme = { base_score = 0.60, long_account_threshold = 0.65, short_account_threshold = 0.35, soft_long_account_threshold = 0.58, soft_short_account_threshold = 0.42, min_close_position_long = 0.58, max_close_position_short = 0.42, min_volume_ratio = 0.90, max_adverse_depth_imbalance = 0.10, max_adverse_microprice_bias = 0.10, sl_buffer_atr = 1.00, min_rr = 1.9 }
oi_divergence = { base_score = 0.60, min_abs_oi_change_pct = 0.01, min_price_change_pct = 0.35, sl_buffer_atr = 1.00, min_rr = 1.9 }
btc_correlation = { base_score = 0.60, min_roc10_abs_pct = 0.15, min_volume_ratio = 0.70, sl_buffer_atr = 0.85, min_rr = 1.9 }
altcoin_season_index = { base_score = 0.60, altseason_long_threshold = 55.0, btc_dominance_threshold = 45.0, min_volume_ratio = 0.80, min_roc10_abs_pct = 0.10, sl_buffer_atr = 0.85, min_rr = 1.9 }

[bot.tracking]
enabled = true
pending_expiry_minutes = 180
active_expiry_minutes = 240
# Reject new signals when mark already chased beyond entry zone (manual limit window).
late_entry_chase_pct = 0.008
outcome_retention_days = 90
move_stop_to_break_even_on_tp1 = true
min_stop_distance_pct = 1.10
max_stop_distance_pct = 15.0
agg_trade_page_limit = 6
agg_trade_page_size = 1000
# MetaSignalMerger direction-conflict window vs recent ACTION signals (hours).
action_window_hours = 4.0

[bot.setups]
# Strategy status metadata is descriptive only; enabled flags control runtime.
# Do not disable a setup because it is marked experimental. Fix its data contract instead.
# Original setups
structure_pullback = true
structure_break_retest = true
wick_trap_reversal = true
squeeze_setup = true
ema_bounce = true
# New setups
fvg_setup = true
order_block = true
liquidity_sweep = true
bos_choch = true
hidden_divergence = true
indicator_divergence = true
funding_reversal = true
cvd_divergence = true
session_killzone = true
breaker_block = true
turtle_soup = true
vwap_trend = true
supertrend_follow = true
price_velocity = true
volume_anomaly = true
volume_climax_reversal = true
keltner_breakout = true
whale_walls = true
spread_strategy = true
depth_imbalance = true
absorption = true
aggression_shift = true
liquidation_heatmap = true
stop_hunt_detection = true
multi_tf_trend = true
rsi_divergence_bottom = true
wyckoff_spring = true
bb_squeeze = true
atr_expansion = true
ls_ratio_extreme = true
oi_divergence = true
btc_correlation = true
altcoin_season_index = true

[bot.scoring]
enabled = true
setup_prior_weight = 0.50
# Component weights are normalized on startup if they do not sum to 1.0.
weight_mtf_alignment = 0.25
weight_volume_quality = 0.20
weight_structure_clarity = 0.20
weight_risk_reward = 0.15
weight_crowd_position = 0.10
weight_oi_momentum = 0.10
funding_rate_extreme = 0.0010
funding_rate_moderate = 0.0005

[bot.alerts]
enabled = true
enable_entry_zone = true
watch_interest_pct = 0.015
entry_zone_pct = 0.003
invalidate_buffer_pct = 0.005
max_watch_alerts_per_hour = 3
watch_symbol_cooldown_minutes = 60
entry_symbol_cooldown_minutes = 15
invalidated_min_age_minutes = 10
watch_expiry_minutes = 60

[bot.ws]
enabled = true
# Root Binance Futures WS endpoint. Manager routes bookTicker to /public and
# market streams to /market internally.
base_url = "wss://fstream.binance.com"
public_base_url = "wss://fstream.binance.com/public"
market_base_url = "wss://fstream.binance.com/market"
# WS kline streams: 15m execution interval only. 5m (and 1h context) load via bounded REST
# when listed in bot.runtime.analysis_kline_intervals — do not add 5m here.
kline_intervals = ["15m"]
subscription_scope = "shortlist"
subscribe_book_ticker = true
# Use all-book stream (`!bookTicker`) to reduce WS pressure.
# Set to "symbol" only if you explicitly need per-symbol real-time updates.
book_ticker_stream_mode = "all"
# Publish bookTicker events to the strategy trigger path at most once per symbol
# per Binance all-book cadence, and only after a meaningful mid-price move.
book_ticker_publish_interval_seconds = 5.0
book_ticker_publish_min_move_bps = 1.0
# NOTE: aggTrade is subscribed only for tracked/active symbols.
# It is never attached to the full shortlist.
subscribe_agg_trade = true
# L2 partial depth is used only for active/tracked shortlist symbols, not the
# whole market. This turns whale_walls/depth_imbalance from L1 proxies into
# real top-20 book measurements while keeping request pressure bounded.
subscribe_depth = true
depth_levels = 20
depth_speed = "500ms"
depth_symbol_limit = 20
max_market_stream_budget = 280
depth_band_bps = 8.0
depth_wall_min_notional = 250000.0
depth_wall_persistence_seconds = 10.0
subscribe_chunk_size = 10
subscribe_chunk_delay_ms = 500
health_check_silence_seconds = 60.0
market_reconnect_grace_seconds = 90.0
agg_trade_window_seconds = 300
# Stale aggTrade events older than this are dropped (separate from market_ticker_freshness).
agg_trade_freshness_seconds = 300
kline_cache_size = 500
warmup_timeout_seconds = 60.0
reconnect_max_delay_seconds = 300.0
max_agg_trade_buffer = 10000
agg_trade_flush_interval_ms = 250
rest_timeout_seconds = 20.0
subscribe_market_streams = true
market_ticker_freshness_seconds = 120.0
force_order_window_seconds = 60
# Intra-candle analysis frequency (lower = more real-time, higher = less CPU load)
intra_candle_throttle_seconds = 60.0
# Optional noise gate for intra-candle scans. 0 disables gating.
intra_candle_min_move_bps = 15.0
# Intra-candle fast lane: cap detectors per bookTicker scan (0 = lane default only).
intra_candle_max_setups = 8
# Optional explicit setup subset for intra-candle (empty = lane-routed setups).
# intra_candle_setup_subset = ["price_velocity", "absorption", "liquidity_sweep"]

[bot.notifiers]
# "none" keeps local/log-only delivery until TG_TOKEN and TARGET_CHAT_ID are set.
# With both Telegram secrets present, load_settings() auto-promotes this to "telegram".
# Set BOT_NOTIFIER_PROVIDER=none to force local/log-only mode for checks.
provider = "none"
send_analytics_companion = true
# When true, channel companion is ACTION-only; WATCH companion goes to operator DM.
analytics_companion_action_only = false

# Remote operator console (private DM commands — works when MacBook and phone are on
# different networks). Requires TELEGRAM_OPERATOR_USER_IDS in .env (your Telegram user id).
# Ops messages go to operator DMs only — NOT to TARGET_CHAT_ID (signal channel).
[bot.notifiers.telegram_operator]
enabled = true
digest_interval_seconds = 1800
poll_timeout_seconds = 25
send_market_context = true
send_startup_report = true
send_digest = true
send_sl_postmortem = true
send_critical_alerts = true
send_watch_escalation = true
# Radar funnel WATCH hints (operator DM only; requires universe.radar.emit_watch_candidates = true)
send_radar_watch_candidate = false
send_watch_companion = true
notify_on_console_start = true

[bot.notifiers.webhook]
enabled = false
webhook_url = ""
include_html = true
# Parallel ops alerts (zero-delivery, critical) — does not replace Telegram channel provider
ops_alerts_enabled = false

[bot.delivery]
min_confirmations = 3
target_rr = [1.9, 3.0, 5.0]
portfolio_max_per_symbol = 2
max_signals_per_minute = 12
# Channel gets concise tracking updates; detailed SL post-mortem goes to operator DM.
# Tier score floors (0–1): ACTION vs WATCH classification in delivery tiers.
action_min_score = 0.72
watch_min_score = 0.55
action_cap_per_cycle = 6
watch_cap_per_cycle = 12
action_cap_per_session = 24
zero_delivery_alert_cycles = 24
watch_escalation_enabled = true
enforce_mtf_gate = true
# Reversal profiles in bear BTC regime: min hard-gate confirmations (default 2-of-5).
reversal_min_confirmations = 3
# Enabled 2026-06-04 after live_check confluence review (OPS-2): weighted primary gate.
use_weighted_confluence = true
weighted_min_hard_legs = 2
portfolio_max_same_direction_regime = 4
portfolio_max_family_direction = 2
portfolio_max_bear_longs = 2
max_strategy_share = 0.25
# Per-setup minimum minutes between deliveries (setup-wide; whale_walls domination guard).
setup_interval_minutes = { whale_walls = 20 }
sl_postmortem_enabled = true
sl_postmortem_to_operators = true

[bot.notifiers.slack]
enabled = false
webhook_url = ""

[bot.notifiers.discord]
enabled = false
webhook_url = ""
username = "crypto-signal-bot"

# Research harvest: deep capture on ~10 symbols (CLI: `python main.py harvest`).
# Keep enabled=false for production; calibration runs after architecture/strategy work.
[bot.research_harvest]
enabled = false
symbols = [
  "BTCUSDT", "ETHUSDT", "SOLUSDT", "XRPUSDT", "BNBUSDT",
  "DOGEUSDT", "LINKUSDT", "XAUUSDT", "XAGUSDT", "PAXGUSDT",
]
output_subdir = "research_harvest"
skip_telegram_delivery = true
route_all_enabled_strategies = true
emit_strategy_routing_skips = true
enable_spot_companion = true
snapshot_on_cycle = true
max_bar_tail = 3

[bot.spot_companion]
enabled = true
base_url = "https://data-api.binance.vision"
lead_symbols = []
refresh_interval_seconds = 60

[bot.intelligence]
enabled = true
runtime_mode = "signal_only"
source_policy = "binance_only"
smart_exit_mode = "heuristic_v1"
gamma_semantics = "proxy_only"
refresh_interval_seconds = 900
write_hourly_reports = true
options_expiry_count = 2
barrier_symbol_count = 2
hard_barrier_pct = 1.5
hard_barrier_window_minutes = 15
smart_exit_enabled = false
smart_exit_threshold = 0.62
regime_detector = "composite"
max_consecutive_stop_losses = 3
stop_loss_pause_hours = 5
benchmark_symbols = ["BTCUSDT", "ETHUSDT", "SOLUSDT", "XAUUSDT", "XAGUSDT"]
option_underlyings = ["BTC", "ETH"]
macro_symbols = ["^VIX", "DX-Y.NYB", "^TNX", "^GSPC"]

# Optional LLM rationales (v1.1 / OPT-2). Keys in .env only. Hot path must stay off.
# See docs/research/LLM_API_INTEGRATION.md
# [bot.intelligence.llm]
# enabled = false
# provider = "none"   # anthropic | openai | google
# use_on_hot_path = false
