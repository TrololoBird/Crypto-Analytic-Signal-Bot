# Clean runtime configuration for the signal bot.
# Secrets stay in .env.
# Copy this file to config.toml and customize as needed.

[bot.runtime]
analysis_concurrency = 8
# Per-symbol strategy executor budget inside SignalEngine. Global symbol
# concurrency is controlled separately by analysis_concurrency.
strategy_concurrency = 10
# Per-strategy compute timeout (seconds) excluding queue wait.
strategy_timeout_seconds = 12.0
strategy_timeout_breaker = 5
# Drop stale strategy work before obsolete bookTicker backlog becomes engine timeouts.
max_strategy_queue_wait_seconds = 30.0
max_signals_per_cycle = 80
event_bus_max_size = 512
event_bus_warn_depth = 384
event_bus_drop_log_interval = 25
telemetry_subdir = "telemetry"
log_level = "INFO"
logs_retention_days = 14
logs_max_files = 120
telemetry_retention_days = 14
telemetry_max_runs = 120
shortlist_refresh_interval_seconds = 7200
emergency_fallback_seconds = 1800
strict_data_quality = true
emit_strategy_routing_skips = false
route_all_enabled_strategies = false
shortlist_unified_routing = true
enable_strategy_lanes = true
max_setup_families_per_symbol = 15
max_setups_per_family = 3
analysis_kline_intervals = ["5m", "15m", "1h"]
diagnostic_trace_limit_per_symbol = 20
# Startup throttling to prevent REST API flood on startup
startup_batch_size = 3
startup_batch_delay_seconds = 3.0
max_concurrent_rest_requests = 3
emergency_context_warmup_timeout_seconds = 120.0
emergency_context_warmup_symbol_limit = 45
emergency_context_fetch_timeout_seconds = 20.0
futures_data_request_limit_per_5m = 900
# OI/L-S derivatives context refresh loop (minutes between full shortlist passes).
oi_refresh_interval_minutes = 30
cycle_timeout_seconds = 120.0
shortlist_lock_timeout_seconds = 10.0
doctor_fail_fast = true
min_restart_interval_seconds = 120
# Dashboard settings
# Dashboard — bind 0.0.0.0 for LAN/mobile Safari; use 127.0.0.1 if local-only
dashboard_host = "0.0.0.0"
dashboard_port = 8080
dashboard_weight_alert_pct = 80.0
dashboard_rate_limit_per_minute = 120
dashboard_audit_log_enabled = true
auto_open_dashboard = false
# Metrics settings
metrics_host = "127.0.0.1"
metrics_port = 9090

# Binance is geo-blocked in some regions (e.g. Russia). Route via a local proxy client.
# Examples: socks5h://127.0.0.1:7890 (Clash/Mihomo), socks5h://127.0.0.1:9050 (Tor)
# Or set BINANCE_PROXY_URL / HTTPS_PROXY in .env (see docs/BINANCE_PROXY_RU.md).
[bot.network]
# Primary egress (optional). Use your own Clash/Tor/VPS endpoints — never commit untrusted public lists.
proxy_url = ""
# Failover chain: bot rotates on transport/geo errors for 24/7 uptime.
proxy_urls = [
  # "socks5://127.0.0.1:7890",
  # "socks5://127.0.0.1:7891",
]
trust_env = true
failover_enabled = true
failover_cooldown_seconds = 300

[bot.universe]
quote_asset = "USDT"
# Stage-1 funnel: rank by 24h quote volume, apply gates, keep top-N before scoring.
light_pool_limit = 180
dynamic_limit = 120
shortlist_limit = 50
min_quote_volume_usd = 50_000_000
min_price_change_pct = 0.5
min_trade_count_24h = 10_000
min_listing_age_days = 90
light_refresh_interval_seconds = 75
medium_refresh_interval_seconds = 900
full_refresh_interval_seconds = 7200
shortlist_spread_max_bps = 8.0
shortlist_book_stale_seconds = 90.0
shortlist_min_tenure_seconds = 1800
shortlist_cache_max_age_seconds = 3600
pinned_symbols = ["BTCUSDT", "ETHUSDT", "SOLUSDT", "XRPUSDT", "XAUUSDT", "XAGUSDT", "PAXGUSDT"]

[bot.universe.radar]
enabled = true
warm_pool_limit = 200
hot_pool_limit = 60
promotion_slots_reserve = 12
impulse_5m_pct = 1.0
vol_spike_zscore = 2.0
change_24h_hot_pct = 4.0
funding_extreme_pct = 0.0008  # fraction (0.0008 = 0.08%)
prescore_boost_hot = 0.12
prescore_boost_warm = 0.05
promotion_cooldown_seconds = 1200
demotion_idle_seconds = 10800
min_quote_volume_usd = 5_000_000
light_rsi_overbought = 72.0
light_rsi_oversold = 28.0
emit_watch_candidates = false

[bot.assets.BTCUSDT]
primary_timeframe = "15m"
context_timeframes = ["1h", "4h"]
excluded_strategies = []
deep_analysis = true

[bot.assets.ETHUSDT]
primary_timeframe = "15m"
context_timeframes = ["1h", "4h"]
excluded_strategies = []
deep_analysis = true

[bot.assets.SOLUSDT]
primary_timeframe = "15m"
context_timeframes = ["1h", "4h"]
excluded_strategies = []
deep_analysis = true

[bot.assets.XRPUSDT]
primary_timeframe = "15m"
context_timeframes = ["1h", "4h"]
excluded_strategies = []
deep_analysis = true

[bot.assets.XAUUSDT]
primary_timeframe = "1h"
context_timeframes = ["4h"]
excluded_strategies = []
deep_analysis = true
filter_overrides = { min_atr_pct = 0.08, max_atr_pct = 0.95, min_adx_1h = 18.0 }

[bot.assets.XAGUSDT]
primary_timeframe = "1h"
context_timeframes = ["4h"]
excluded_strategies = []
deep_analysis = true

[bot.filters]
cooldown_minutes = 60
symbol_cooldown_minutes = 120
outcome_sl_cooldown_minutes = 90
family_cooldown_minutes = 45
max_spread_bps = 8.0
# Keep ATR gate above extreme-noise floor, but avoid over-pruning live shortlist.
min_atr_pct = 0.18
max_atr_pct = 10.0
min_adx_1h = 22.0
min_risk_reward = 1.9
# Lower bound for post-confluence score; calibrated from live reject telemetry
# while preserving RR/spread/stop hard-gates.
min_score = 0.53
freshness_15m_minutes = 16
freshness_5m_minutes = 8
freshness_1h_hours = 2
freshness_4h_hours = 10
min_bars_15m = 210
min_bars_1h = 210
min_bars_5m = 100
min_bars_4h = 210
max_mark_price_deviation_pct = 0.005
max_entry_deviation_atr_mult = 1.2
regime_filter_enabled = true
trend_conflict_soft = true
# Composable filter stages — see bot/delivery/filter_stages.py (DEFAULT_FILTER_STAGES).
# Empty list disables all stages; omit key for module defaults.
enabled_stages = ["freshness", "mark_deviation", "spread", "atr", "stop", "rr", "scoring", "min_score"]

[bot.filters.setups]
ema_bounce = { base_score = 0.62, min_adx_1h = 15.0, bias_mismatch_penalty = 0.75, sl_buffer_atr = 0.85, min_rr = 1.9, ema_touch_tolerance_pct = 0.005, bounce_threshold_atr = 0.12 }
structure_pullback = { base_score = 0.60, bias_mismatch_penalty = 0.75, tp_too_close_penalty = 0.75, sl_buffer_atr = 0.95, min_rr = 1.9, ema_proximity_pct = 0.990, ema_deep_pullback_pct = 0.965 }
structure_break_retest = { base_score = 0.60, threshold_adx = 18.0, bias_mismatch_penalty = 0.75, sl_buffer_atr = 0.80, min_rr = 1.9, min_vol_breakout = 0.85, breakout_threshold = 0.0005, retest_atr_mult = 0.85, fallback_lookback_bars = 12, enable_15m_range_fallback = 1.0 }
wick_trap_reversal = { base_score = 0.60, bias_mismatch_penalty = 0.75, sl_buffer_atr = 1.00, min_rr = 2.5, wick_through_atr_mult = 0.3, closed_back_atr_mult = 0.10, min_volume_ratio = 1.2, max_confirmation_bars = 4, supertrend_opposes_penalty = 0.88 }
