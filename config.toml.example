[bot.tracking]
enabled = true
pending_expiry_minutes = 240
active_expiry_minutes = 240
late_entry_chase_pct = 0.002
outcome_retention_days = 90
move_stop_to_break_even_on_tp1 = true
persist_trailing_stop = true
min_stop_distance_pct = 1.10
max_stop_distance_pct = 15.0
agg_trade_page_limit = 6
agg_trade_page_size = 1000
pre_activation_gate_enabled = true
activation_staleness_atr_mult = 1.2
activation_context_max_age_seconds = 120
activation_min_score = 0.60
activation_score_decay_per_bar = 0.03
reversal_activation_pin_required = false
reversal_pending_expiry_minutes = 150
continuation_pending_expiry_minutes = 240
trend_follow_activation_requires_close = true
action_window_hours = 4.0
mark_price_max_age_seconds = 30.0
# Optional per-setup pending TTL overrides (minutes); catalog Part 3 defaults apply when unset.
# setup_ttl_minutes = { liquidity_sweep = 45, order_block = 180 }

[bot.setups]

# Strategy status metadata is descriptive only; enabled flags control runtime.
# Do not disable a setup because it is marked experimental. Fix its data contract instead.
# Original setups
structure_pullback = true
structure_break_retest = true
wick_trap_reversal = true
squeeze_setup = true
ema_bounce = true
# New setups
fvg_setup = true
order_block = true
liquidity_sweep = true
bos_choch = true
indicator_divergence = true
funding_reversal = true
cvd_divergence = true
turtle_soup = true
vwap_trend = true
supertrend_follow = true
price_velocity = true
volume_anomaly = true
volume_climax_reversal = true
keltner_breakout = true
absorption = true
liquidation_heatmap = true
multi_tf_trend = true
wyckoff_spring = true
ls_ratio_extreme = true
oi_divergence = true
btc_correlation = true
altcoin_season_index = true
pinbar_reversal = true

[bot.scoring]
enabled = true
setup_prior_weight = 0.55
# Component weights are normalized on startup if they do not sum to 1.0.
weight_mtf_alignment = 0.25
weight_volume_quality = 0.20
weight_structure_clarity = 0.20
weight_risk_reward = 0.15
weight_crowd_position = 0.10
weight_oi_momentum = 0.10
funding_rate_extreme = 0.0010
funding_rate_moderate = 0.0005

[bot.alerts]
enabled = true
enable_entry_zone = true
watch_interest_pct = 0.015
entry_zone_pct = 0.003
invalidate_buffer_pct = 0.005
max_watch_alerts_per_hour = 3
watch_symbol_cooldown_minutes = 60
entry_symbol_cooldown_minutes = 15
invalidated_min_age_minutes = 10
watch_expiry_minutes = 60

[bot.ws]
enabled = true
# Root Binance Futures WS endpoint. Manager routes bookTicker to /public and
# market streams to /market internally.
base_url = "wss://fstream.binance.com"
public_base_url = "wss://fstream.binance.com/public"
market_base_url = "wss://fstream.binance.com/market"
# Keep only the execution interval on WS to prevent sustained stream overload.
# 5m/1h context is fetched through the bounded REST cache path when needed.
kline_intervals = ["15m"]
subscription_scope = "shortlist"
subscribe_book_ticker = true
# Use all-book stream (`!bookTicker`) to reduce WS pressure.
# Set to "symbol" only if you explicitly need per-symbol real-time updates.
book_ticker_stream_mode = "all"
# Publish bookTicker events to the strategy trigger path at most once per symbol
# per Binance all-book cadence, and only after a meaningful mid-price move.
book_ticker_publish_interval_seconds = 5.0
book_ticker_publish_min_move_bps = 1.0
# NOTE: aggTrade is subscribed only for tracked/active symbols.
# It is never attached to the full shortlist.
subscribe_agg_trade = true
# L2 partial depth is used only for active/tracked shortlist symbols, not the
# whole market. This turns whale_walls/depth_imbalance from L1 proxies into
# real top-20 book measurements while keeping request pressure bounded.
subscribe_depth = true
depth_levels = 20
depth_speed = "500ms"
depth_symbol_limit = 20
max_market_stream_budget = 280
depth_band_bps = 8.0
depth_wall_min_notional = 250000.0
depth_wall_persistence_seconds = 10.0
subscribe_chunk_size = 10
subscribe_chunk_delay_ms = 500
health_check_silence_seconds = 60.0
market_reconnect_grace_seconds = 90.0
agg_trade_window_seconds = 300
kline_cache_size = 500
warmup_timeout_seconds = 60.0
reconnect_max_delay_seconds = 300.0
max_agg_trade_buffer = 10000
agg_trade_flush_interval_ms = 250
rest_timeout_seconds = 20.0
subscribe_market_streams = true
market_ticker_freshness_seconds = 30.0
agg_trade_freshness_seconds = 300
force_order_window_seconds = 60
# Intra-candle analysis frequency (lower = more real-time, higher = less CPU load)
intra_candle_throttle_seconds = 60.0
# Optional noise gate for intra-candle scans. 0 disables gating.
intra_candle_min_move_bps = 15.0
intra_candle_max_setups = 0

[bot.notifiers]
# "none" keeps local/log-only delivery until TG_TOKEN and TARGET_CHAT_ID are set.
# With both Telegram secrets present, load_settings() auto-promotes this to "telegram".
# Set BOT_NOTIFIER_PROVIDER=none to force local/log-only mode for checks.
provider = "telegram"
send_analytics_companion = false

[bot.notifiers.telegram_operator]
enabled = true
digest_interval_seconds = 1800
poll_timeout_seconds = 25
send_market_context = true
send_startup_report = true
send_digest = true
send_sl_postmortem = true
send_critical_alerts = true
