order_block = { base_score = 0.60, min_ob_impulse_atr = 0.9, ob_max_age = 72.0, touch_buffer_atr = 0.25, sl_buffer_atr = 0.85, min_rr = 1.9 }
liquidity_sweep = { base_score = 0.62, threshold_tol = 0.0015, sl_buffer_atr = 0.90, min_rr = 2.5, max_sweep_age_bars = 4, max_entry_distance_atr = 1.25 }
bos_choch = { base_score = 0.62, bias_mismatch_penalty = 0.75, sl_buffer_atr = 1.15, min_rr = 1.9, swing_lookback = 5, external_swing_lookback = 18, min_swings = 3, breakout_threshold_atr = 0.20, max_break_age_bars = 10, max_retest_age_bars = 36, retest_atr_mult = 1.50, min_volume_ratio = 0.80 }
