# Clean runtime configuration for the signal bot.
# Secrets stay in .env.
# Copy this file to config.toml and customize as needed.

[bot.runtime]
analysis_concurrency = 8
# Per-symbol strategy executor budget inside SignalEngine. Global symbol
# concurrency is controlled separately by analysis_concurrency.
strategy_concurrency = 10
# Per-strategy compute timeout (seconds) excluding queue wait.
strategy_timeout_seconds = 12.0
strategy_timeout_breaker = 5
# Drop stale strategy work before obsolete bookTicker backlog becomes engine timeouts.
max_strategy_queue_wait_seconds = 30.0
max_signals_per_cycle = 80
event_bus_max_size = 512
event_bus_warn_depth = 384
event_bus_drop_log_interval = 25
telemetry_subdir = "telemetry"
log_level = "DEBUG"
logs_retention_days = 14
logs_max_files = 120
telemetry_retention_days = 14
telemetry_max_runs = 120
shortlist_refresh_interval_seconds = 7200
emergency_fallback_seconds = 1800
strict_data_quality = true
emit_strategy_routing_skips = true
route_all_enabled_strategies = true
shortlist_unified_routing = true
enable_strategy_lanes = true
max_setup_families_per_symbol = 15
max_setups_per_family = 3
analysis_kline_intervals = ["5m", "15m", "1h"]
diagnostic_trace_limit_per_symbol = 20
# Startup throttling to prevent REST API flood on startup
startup_batch_size = 3
startup_batch_delay_seconds = 3.0
max_concurrent_rest_requests = 8
emergency_context_warmup_timeout_seconds = 120.0
emergency_context_warmup_symbol_limit = 45
emergency_context_fetch_timeout_seconds = 20.0
futures_data_request_limit_per_5m = 900
oi_refresh_interval_minutes = 30
cycle_timeout_seconds = 120.0
shortlist_lock_timeout_seconds = 10.0
doctor_fail_fast = true
min_restart_interval_seconds = 120
# Dashboard settings — 0.0.0.0 allows iPhone on same Wi‑Fi (see Outcomes → Mobile)
dashboard_host = "0.0.0.0"
dashboard_port = 8080
dashboard_weight_alert_pct = 80.0
dashboard_rate_limit_per_minute = 120
dashboard_audit_log_enabled = true
auto_open_dashboard = false
# Metrics settings
metrics_host = "127.0.0.1"
metrics_port = 9090

