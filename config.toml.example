aggression_shift = { base_score = 0.60, min_shift = 0.05, min_proxy_shift = 0.025, shift_std_mult = 0.75, delta_spike_mult = 2.0, min_volume_ratio = 0.90, signal_lookback_bars = 6, max_entry_drift_atr = 0.75, sl_buffer_atr = 0.85, min_rr = 1.9 }
liquidation_heatmap = { base_score = 0.60, min_liquidation_score = 0.28, min_proxy_volume_ratio = 1.10, min_proxy_wick_atr = 0.20, proxy_lookback_bars = 12, min_close_position_long = 0.55, max_close_position_short = 0.45, min_volume_ratio = 0.90, sl_buffer_atr = 1.05, min_rr = 1.75, allow_proxy_liquidation = 1.0 }
